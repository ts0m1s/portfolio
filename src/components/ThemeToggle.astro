---
interface Props {
  /** Unique per instance; the SVG mask needs its own id. */
  id: string;
}

const { id } = Astro.props;
const maskId = `theme-toggle-mask-${id}`;
---

<button class="theme-toggle" type="button" aria-label="Turn the lights off" title="Pull me">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <mask id={maskId}>
      <rect width="24" height="24" fill="#fff"></rect>
      <circle class="theme-toggle__cut" cx="12" cy="12" r="7" fill="#000"></circle>
    </mask>
    <circle class="theme-toggle__core" cx="12" cy="12" r="9" fill="currentColor" mask={`url(#${maskId})`}></circle>
    <path
      class="theme-toggle__rays"
      d="M12 .5v2.2M12 21.3v2.2M3.9 3.9l1.6 1.6M18.5 18.5l1.6 1.6M.5 12h2.2M21.3 12h2.2M3.9 20.1l1.6-1.6M18.5 5.5l1.6-1.6"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"></path>
  </svg>
</button>
