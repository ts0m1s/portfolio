---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// Mirrors the post's Markdown structure: ## sections and ### subsections.
const headings = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{headings.length >= 2 && (
  <aside class="toc">
    <details class="toc__box" open>
      <summary>Contents</summary>
      <ol>
        {headings.map(({ depth, slug, text }) => (
          <li class={`toc__h${depth}`}>
            <a href={`#${slug}`}>{text}</a>
          </li>
        ))}
      </ol>
    </details>
  </aside>
)}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const box = document.querySelector<HTMLDetailsElement>('.toc__box');

  if (links.length && box) {
    // Collapsed by default when the contents sit above the article (narrow screens).
    const wide = matchMedia('(min-width: 1280px)');
    const sync = () => (box.open = wide.matches);
    sync();
    wide.addEventListener('change', sync);

    // Highlight the section currently being read.
    const sections = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((el): el is HTMLElement => el !== null);

    const mark = (id?: string) =>
      links.forEach((link) => link.toggleAttribute('aria-current', decodeURIComponent(link.hash.slice(1)) === id));

    // A clicked entry stays highlighted until the reader scrolls on their own,
    // even if the page can't scroll far enough to bring that heading to the top.
    let pinned: string | undefined;

    const setActive = () => {
      if (pinned) return;
      const line = innerHeight * 0.25;
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      let current = sections[0];
      for (const section of sections) {
        const top = section.getBoundingClientRect().top;
        // At the very bottom, any heading still on screen counts as reached.
        if (top <= line || (atBottom && top < innerHeight)) current = section;
      }
      mark(current?.id);
    };

    links.forEach((link) =>
      link.addEventListener('click', () => {
        pinned = decodeURIComponent(link.hash.slice(1));
        mark(pinned);
      }),
    );

    const unpin = () => {
      pinned = undefined;
      setActive();
    };
    for (const type of ['wheel', 'touchmove', 'keydown']) addEventListener(type, unpin, { passive: true });

    setActive();
    addEventListener('scroll', setActive, { passive: true });
  }
</script>
