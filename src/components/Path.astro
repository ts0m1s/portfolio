---
import { url } from '../utils';

interface Props {
  /** Where the page sits below /home. The last segment is the current page. */
  segments?: { label: string; href?: string }[];
}

const { segments = [] } = Astro.props;
const all = [{ label: 'home', href: url() }, ...segments];
---

<!-- The page's location, written like a directory. Changing page types it like `cd` (scripts/path-typer.ts). -->
<nav class="path" aria-label="You are here">
  {all.map(({ label, href }, i) => (
    <span class="path__segment" data-segment={label}>
      <span class="path__sep" aria-hidden="true">/</span>
      {i === all.length - 1 ? <span aria-current="page">{label}</span> : <a href={href}>{label}</a>}
    </span>
  ))}
</nav>
