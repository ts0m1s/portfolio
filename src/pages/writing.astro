---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import TagFilter from '../components/TagFilter.astro';
import { CONTENT } from '../config';
import { getPosts, url } from '../utils';

const posts = await getPosts();
---

<Base
  title={CONTENT.writing.title}
  description={CONTENT.writing.description}
  path={[{ label: 'Writing' }]}
  heading={CONTENT.writing.title}
>
  {import.meta.env.DEV && (
    <p class="dev-write">
      <a href={url('write/')} data-astro-reload>+ New post</a>
    </p>
  )}
  <TagFilter active="all" />
  <PostList posts={posts} showDescription />
</Base>
