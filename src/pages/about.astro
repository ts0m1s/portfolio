---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { CONTENT, SITE, SOCIALS } from '../config';
import { edit, editItem, editList } from '../edit/attrs';
import { url } from '../utils';

// The text is in src/content/site.json under "about". Edit it there, or in the browser
// with the editor (`npm run dev`, then press E).
const about = CONTENT.about;
const cv = about.cv ? url(about.cv) : '';
const email = SOCIALS.find(({ name }) => name === 'email')?.url;
const newRow = { when: 'Year', what: 'Title', where: 'Place', note: 'One sentence about it.' };
---

<Base
  title={about.title}
  description={`About ${SITE.name}: background, skills and how to get in touch.`}
  path={[{ label: 'About me' }]}
>
  <article class="about">
    <header class="about__intro">
      <h1 {...edit('about.title')}>{about.title}</h1>
      <p class="lede" {...edit('about.summary')}>{about.summary}</p>
      <div class="about__actions">
        {email && <a class="button" href={email} {...edit('about.buttons.email')}>{about.buttons.email}</a>}
        {cv && <a class="button button--quiet" href={cv} {...edit('about.buttons.cv')}>{about.buttons.cv}</a>}
        <a class="button button--quiet" href={url('writing/')} {...edit('about.buttons.writing')}>{about.buttons.writing}</a>
      </div>
    </header>

    <section>
      <h2 {...edit('about.focusHeading')}>{about.focusHeading}</h2>
      <ul class="cards" {...editList('about.focus', { title: 'New focus area', text: 'What it covers.' })}>
        {about.focus.map(({ title, text }, i) => (
          <li {...editItem(i)}>
            <h3 {...edit(`about.focus.${i}.title`)}>{title}</h3>
            <p {...edit(`about.focus.${i}.text`)}>{text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 {...edit('about.skillsHeading')}>{about.skillsHeading}</h2>
      <dl class="skills" {...editList('about.skills', { group: 'Group', items: ['Skill', 'Another skill'] })}>
        {about.skills.map(({ group, items }, i) => (
          <div {...editItem(i)}>
            <dt {...edit(`about.skills.${i}.group`)}>{group}</dt>
            <dd {...edit(`about.skills.${i}.items`, 'list')}>{items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    {(['experience', 'education'] as const).map((key) => (
      <section>
        <h2 {...edit(`about.${key}Heading`)}>{about[`${key}Heading`]}</h2>
        <ol class="timeline" {...editList(`about.${key}`, newRow)}>
          {about[key].map(({ when, what, where, note }, i) => (
            <li {...editItem(i)}>
              <span class="timeline__when" {...edit(`about.${key}.${i}.when`)}>{when}</span>
              <div>
                <p class="timeline__what">
                  <span class="timeline__role" {...edit(`about.${key}.${i}.what`)}>{what}</span>,{' '}
                  <span class="timeline__place" {...edit(`about.${key}.${i}.where`)}>{where}</span>
                </p>
                <p class="timeline__note" {...edit(`about.${key}.${i}.note`)}>{note}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section>
      <h2 {...edit('about.contactHeading')}>{about.contactHeading}</h2>
      <p {...edit('about.contactText')}>{about.contactText}</p>
      <SocialLinks labels />
    </section>
  </article>
</Base>
