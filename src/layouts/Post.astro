---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import { TAGS } from '../config';
import { formatDate, readingTime, url, type Post } from '../utils';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
}

const { post, headings, newer, older } = Astro.props;
const { title, description, date, updated, tags } = post.data;
---

<Base
  title={title}
  description={description}
  type="article"
  path={[{ label: 'Writing', href: url('writing/') }, { label: post.id }]}
>
  <div class="post-layout">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        Posted <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <>, updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
        {tags.length > 0 && (
          <>
            {' in '}
            {tags.map((tag, i) => (
              <>{i > 0 && ' and '}<a href={url(`tags/${tag}/`)}>{TAGS[tag]}</a></>
            ))}
          </>
        )}. {readingTime(post.body)}.
      </p>
    </header>

    <Toc headings={headings} />

    <article class="post">
      <div class="prose">
        <slot />
      </div>

      {(older || newer) && (
        <nav class="post-nav" aria-label="More posts">
          {older && (
            <a class="post-nav__older" href={url(`posts/${older.id}/`)}>
              <small>Older post</small>
              <span>{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a class="post-nav__newer" href={url(`posts/${newer.id}/`)}>
              <small>Newer post</small>
              <span>{newer.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</Base>
